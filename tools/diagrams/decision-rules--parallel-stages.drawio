        <mxCell id="q0" value="$$\begin{aligned}\min\ &amp;f(\mathbf{x}_{1},\mathbf{y}_{1})\\[2pt]\text{s.t.}\ &amp;\mathcal{T}(\mathbf{x}_{0},\mathbf{x}_{1},{\color{red}w_{1}},\mathbf{y}_{1})=\mathbf{0},\\&amp;h(\mathbf{x}_{1},\mathbf{y}_{1},{\color{red}w_{1}})\ge\mathbf{0},\\[2pt]&amp;\mathbf{x}_{0}={\color{red}\hat{\mathbf{x}}_{0}}\quad(:\boldsymbol\mu_{1}),\\&amp;\mathbf{x}_{1}={\color{red}\hat{\mathbf{x}}_{1}}\quad(:\bar{\boldsymbol\lambda}_{1})\end{aligned}$$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="10" y="202" width="178" height="112" as="geometry" /></mxCell>
