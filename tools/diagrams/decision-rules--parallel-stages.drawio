        <mxCell id="q1" value="$$\begin{aligned}\min\ &amp;f(\mathbf{x}_{2},\mathbf{y}_{2})\\[2pt]\text{s.t.}\ &amp;\mathcal{T}(\mathbf{x}_{1},\mathbf{x}_{2},{\color{red}w_{2}},\mathbf{y}_{2})=\mathbf{0},\\&amp;h(\mathbf{x}_{2},\mathbf{y}_{2},{\color{red}w_{2}})\ge\mathbf{0},\\[2pt]&amp;\mathbf{x}_{1}={\color{red}\hat{\mathbf{x}}_{1}}\quad(:\boldsymbol\mu_{2}),\\&amp;\mathbf{x}_{2}={\color{red}\hat{\mathbf{x}}_{2}}\quad(:\bar{\boldsymbol\lambda}_{2})\end{aligned}$$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="202" y="202" width="178" height="112" as="geometry" /></mxCell>
