        <mxCell id="q2" value="$$\begin{aligned}\min\ &amp;f(\mathbf{x}_{T},\mathbf{y}_{T})\\[2pt]\text{s.t.}\ &amp;\mathcal{T}(\mathbf{x}_{T-1},\mathbf{x}_{T},{\color{red}w_{T}},\mathbf{y}_{T})=\mathbf{0},\\&amp;h(\mathbf{x}_{T},\mathbf{y}_{T},{\color{red}w_{T}})\ge\mathbf{0},\\[2pt]&amp;\begin{aligned}\mathbf{x}_{T-1}&amp;={\color{red}\hat{\mathbf{x}}_{T-1}}\quad(:\boldsymbol\mu_{T}),\\\mathbf{x}_{T}&amp;={\color{red}\hat{\mathbf{x}}_{T}}\phantom{_{-1}}\quad(:\bar{\boldsymbol\lambda}_{T})\end{aligned}\end{aligned}$$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="408" y="202" width="194" height="112" as="geometry" /></mxCell>
